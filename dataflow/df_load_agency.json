{
	"name": "df_load_agency",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_adls_agency_master",
						"type": "DatasetReference"
					},
					"name": "SrcAgency",
					"description": "Daten aus ds_adls_agency_master\nimportieren"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_sqldb_agency_master",
						"type": "DatasetReference"
					},
					"name": "SinkAgency"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          AgencyID as short,",
				"          AgencyName as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcAgency",
				"SrcAgency sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AgencyID as string,",
				"          AgencyName as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AgencyID,",
				"          AgencyName",
				"     )) ~> SinkAgency"
			]
		}
	}
}